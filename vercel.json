
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/:slug((?!nagu-saabsan|deeqo-waxbarasho|seminars|fursadaha-shaqo|adeegyadeena|nala-soo-xiriir|privacy|terms|api|sitemap\\.xml)[^/]+)",
      "destination": "/api/article?slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
