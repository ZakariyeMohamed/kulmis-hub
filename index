async function loadDbOpportunities(){

const endpoints=[

`${SUPABASE_URL}/rest/v1/opportunities?select=*&published=eq.true`,

`${SUPABASE_URL}/rest/v1/opportunities?select=*`

];

dbOpportunities=[];

let lastError='';


for(
const endpoint of endpoints
){

try{

const controller=
new AbortController();

const timer=
setTimeout(
()=>controller.abort(),
10000
);


const res=
await fetch(
endpoint,
{
method:'GET',

headers:{
apikey:SUPABASE_KEY,
Authorization:
`Bearer ${SUPABASE_KEY}`,
Accept:'application/json'
},

cache:'no-store',

signal:controller.signal

}
);


clearTimeout(timer);


if(!res.ok){

lastError=
`Supabase HTTP ${res.status}`;

continue;

}


const rows=
await res.json();


if(!Array.isArray(rows))
continue;


dbOpportunities=
rows.filter(row=>{

if(
!Object.prototype.hasOwnProperty.call(
row,
'published'
)
){
return true;
}

return row.published===true;

});


dbOpportunities.sort(
(a,b)=>
String(
b.created_at||''
).localeCompare(
String(
a.created_at||''
)
)
);


return true;


}catch(err){

lastError=
err&&err.name==='AbortError'
?
'Supabase request timed out'
:
String(err);

}

}


console.warn(
'KULMIS HUB Supabase load failed:',
lastError
);

return false;

}


