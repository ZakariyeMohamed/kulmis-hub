function safe(v){

return String(v??'').replace(
/[&<>"']/g,
m=>({
'&':'&amp;',
'<':'&lt;',
'>':'&gt;',
'"':'&quot;',
"'":'&#39;'
}[m])
);

}


function norm(v){

return String(v??'')
.trim()
.toLowerCase();

}


function countryMatches(row,country){

